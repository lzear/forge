{
  "name": "@lzear/eslint-config",
  "version": "4.4.4",
  "description": "Shared ESLint flat config for lzear repos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzear/forge.git",
    "directory": "packages/eslint-config"
  },
  "author": "lzear",
  "type": "module",
  "exports": "./dist/index.js",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "eslint",
    "eslint-config",
    "eslintconfig",
    "flat-config",
    "lint"
  ],
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4",
    "@eslint/js": "^10",
    "@stylistic/eslint-plugin": "^5",
    "@vitest/eslint-plugin": "^1",
    "eslint-config-prettier": "^10",
    "eslint-import-resolver-typescript": "^4",
    "eslint-module-utils": "^2",
    "eslint-package-json": "^0.3",
    "eslint-plugin-de-morgan": "^2",
    "eslint-plugin-import-x": "^4",
    "eslint-plugin-jsx-a11y": "^6",
    "eslint-plugin-n": "^18",
    "eslint-plugin-prefer-arrow": "^1",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-promise": "^7",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-dom": "^5",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-perf": "^3",
    "eslint-plugin-react-web-api": "^5",
    "eslint-plugin-react-x": "^5",
    "eslint-plugin-regexp": "^3",
    "eslint-plugin-simple-import-sort": "^14",
    "eslint-plugin-sonarjs": "^4",
    "eslint-plugin-unicorn": "^73",
    "globals": "^17",
    "prettier": "^3",
    "typescript-eslint": "^8"
  },
  "devDependencies": {
    "@lzear/configs": "workspace:*",
    "@vitest/coverage-v8": "^4",
    "eslint": "^10",
    "tsup": "^8",
    "vitest": "^4"
  },
  "peerDependencies": {
    "eslint": "^10"
  }
}
