{
  "name": "@lzear/repo-lint",
  "version": "6.1.0",
  "description": "Checks lzear repos against forge standards",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzear/forge.git",
    "directory": "packages/repo-lint"
  },
  "author": "lzear",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./templates/codacy.yml": "./templates/codacy.yml",
    "./templates/editorconfig": "./templates/editorconfig",
    "./templates/init/LICENSE": "./templates/init/LICENSE",
    "./templates/init/README.md": "./templates/init/README.md",
    "./templates/init/commitlint.config": "./templates/init/commitlint.config",
    "./templates/init/eslint.config": "./templates/init/eslint.config",
    "./templates/init/gitignore": "./templates/init/gitignore",
    "./templates/init/index": "./templates/init/index",
    "./templates/init/index.test": "./templates/init/index.test",
    "./templates/init/main.yml": "./templates/init/main.yml",
    "./templates/init/renovate.json": "./templates/init/renovate.json",
    "./templates/init/tsconfig": "./templates/init/tsconfig",
    "./templates/init/vite-index": "./templates/init/vite-index",
    "./templates/init/vitest.config": "./templates/init/vitest.config",
    "./templates/lefthook.yml": "./templates/lefthook.yml",
    "./templates/zizmor.yml": "./templates/zizmor.yml"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "templates"
  ],
  "keywords": [
    "checks",
    "ci",
    "compliance",
    "lint",
    "repo"
  ],
  "dependencies": {
    "@arethetypeswrong/cli": "^0.18",
    "fallow": "^3",
    "npm-check-updates": "^23",
    "publint": "^0.3",
    "semver": "^7",
    "sherif": "^1"
  },
  "devDependencies": {
    "@lzear/configs": "workspace:*",
    "@types/node": "^26",
    "@types/semver": "^7",
    "@vitest/coverage-v8": "^5",
    "tsdown": "^0.23",
    "vite": "^8",
    "vitest": "^5"
  }
}
