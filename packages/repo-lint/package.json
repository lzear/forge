{
  "name": "@lzear/repo-lint",
  "version": "4.4.4",
  "description": "Checks lzear repos against forge standards",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzear/forge.git",
    "directory": "packages/repo-lint"
  },
  "author": "lzear",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": "./dist/bin.js",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "checks",
    "ci",
    "compliance",
    "lint",
    "repo"
  ],
  "dependencies": {
    "@arethetypeswrong/cli": "^0.18",
    "knip": "^6",
    "npm-check-updates": "^23",
    "publint": "^0.3",
    "semver": "^7",
    "sherif": "^1"
  },
  "devDependencies": {
    "@lzear/configs": "workspace:*",
    "@types/node": "^26",
    "@types/semver": "^7",
    "@vitest/coverage-v8": "^4",
    "tsup": "^8",
    "vitest": "^4"
  }
}
