{
  "name": "forge",
  "version": "0.0.0",
  "private": true,
  "description": "lzear dev tooling monorepo",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "build": "yarn workspaces foreach -A --topological run build",
    "lint": "eslint .",
    "ncu": "forge update",
    "prepare": "lefthook install",
    "qa": "yarn install --immutable && yarn build && concurrently -g 'yarn typecheck' 'yarn lint' 'yarn test' && yarn forge check",
    "setup-repo": "forge setup",
    "test": "yarn workspaces foreach -A run test",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "version-packages": "changeset version"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^2",
    "@commitlint/cli": "^21",
    "@lzear/configs": "workspace:*",
    "@lzear/forge": "workspace:*",
    "@typescript/native": "npm:typescript@^7",
    "concurrently": "^10",
    "eslint": "^10",
    "lefthook": "^2",
    "typescript": "npm:@typescript/typescript6@^6"
  }
}
