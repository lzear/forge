{
  "name": "forge",
  "version": "0.0.0",
  "private": true,
  "description": "lzear dev tooling monorepo",
  "repository": "github:lzear/forge",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "build": "yarn workspaces foreach -A --topological run build",
    "lint": "eslint .",
    "ncu": "forge update",
    "prepare": "lefthook install",
    "qa": "yarn install --immutable && yarn build && concurrently -g 'yarn typecheck' 'yarn lint' 'yarn test' 'yarn lzear-sync-jsr --check' 'yarn forge check'",
    "e2e:init": "node scripts/init-e2e.ts",
    "housekeep": "yarn forge update && yarn test -u && yarn qa",
    "test": "yarn workspaces foreach -A run test",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "zizmor": "zizmor --config .github/zizmor.yml .github",
    "version-packages": "yarn lzear-changelog && node packages/eslint-config/scripts/rule-notes.ts --changelog CHANGELOG.md && changeset version && yarn lzear-sync-jsr"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^3",
    "@commitlint/cli": "^21",
    "@lzear/configs": "workspace:*",
    "@lzear/forge": "workspace:*",
    "@types/node": "^26",
    "@typescript/native": "npm:typescript@^7",
    "concurrently": "^10",
    "eslint": "^10",
    "lefthook": "^2",
    "typescript": "npm:@typescript/typescript6@^6"
  }
}
